# Database
DATABASE_URL=postgresql://ctb:ctb_secret@localhost:5432/ctb_db

# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Scanner
SCANNER_INTERVAL_SECONDS=60
SUPPORTED_CHAINS=["solana","ethereum","base","robinhood"]

# DexScreener
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# Market Cap Category Thresholds (in USD)
# Early
EARLY_MC_MIN=100000
EARLY_MC_MAX=1000000
EARLY_MIN_VOLUME=100000
EARLY_MIN_LIQUIDITY=40000

# Mid
MID_MC_MIN=1000000
MID_MC_MAX=10000000
MID_MIN_VOLUME=500000
MID_MIN_LIQUIDITY=150000

# Large
LARGE_MC_MIN=10000000
LARGE_MC_MAX=300000000
LARGE_MIN_VOLUME=2000000
LARGE_MIN_LIQUIDITY=500000

# Scoring Weights (must sum to 1.0)
WEIGHT_LIQUIDITY=0.20
WEIGHT_VOLUME=0.25
WEIGHT_BUY_PRESSURE=0.20
WEIGHT_TOKEN_AGE=0.10
WEIGHT_SOCIAL_PRESENCE=0.10
WEIGHT_PRICE_TREND=0.15
